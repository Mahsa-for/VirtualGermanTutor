# Virtual German Tutor — optional configuration.
#
# You do NOT put your Modal or Tavus keys here. Those are entered in the web UI
# and used only at runtime on your own machine / accounts.

# App
APP_ENV=development
PORT=8080

# Set MOCK_MODE=false to use real Modal + Tavus. Leave true to try the UI with a
# local placeholder session (no keys, no GPU).
MOCK_MODE=true

# Model served on your Modal GPU. Must match MODEL_NAME in modal_app/german_tutor_modal.py.
MODAL_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Conversation limits / endpoint protection.
TAVUS_MAX_DURATION_SECONDS=900
SESSION_CREATE_RATE_LIMIT_PER_MINUTE=8
