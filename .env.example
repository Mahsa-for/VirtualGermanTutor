# App
APP_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://virtual-german-tutor-743231335063.us-central1.run.app
MOCK_MODE=false

# Tavus
TAVUS_API_KEY=replace_with_your_tavus_api_key
# Set from Tavus docs for your account; leave empty in mock mode
TAVUS_SESSION_CREATE_URL=https://tavusapi.com/v2/conversations
TAVUS_SESSION_END_URL_TEMPLATE=https://tavusapi.com/v2/conversations/{session_id}/end

# Exact JSON payload expected by Tavus for conversation/session creation.
# Available placeholders: {level}, {topic}, {instructions}, {llm_endpoint}, {max_duration_seconds}
#TAVUS_SESSION_PAYLOAD_TEMPLATE={"replace":"with_official_tavus_payload"}
TAVUS_SESSION_PAYLOAD_TEMPLATE={{"pal_id":"pf1e2dc225a6","conversation_name":"German Tutor - {level} - {topic}","conversational_context":"Learner level: {level}. Practice topic: {topic}.","policy":"eu","properties":{{"max_call_duration":{max_duration_seconds},"participant_left_timeout":10,"participant_absent_timeout":120}}}}

# ****** Tavus will send to /api/tavus/llm/chat/completions
TAVUS_LLM_AUTH_TOKEN=replace_with_random_shared_secret
TAVUS_MAX_DURATION_SECONDS=900
SESSION_CREATE_RATE_LIMIT_PER_MINUTE=8

# Google Cloud Vertex AI
GCP_PROJECT_ID=germantutor-511509
GCP_REGION=us-central1
GEMINI_MODEL=gemini-2.0-flash-001
